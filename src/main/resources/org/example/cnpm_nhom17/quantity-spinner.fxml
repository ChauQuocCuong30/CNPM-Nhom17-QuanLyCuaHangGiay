<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<fx:root type="javafx.scene.layout.HBox" alignment="CENTER" spacing="5.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Button fx:id="minusButton" mnemonicParsing="false" text="-" />
        <TextField fx:id="quantityTextField" alignment="CENTER" prefWidth="50.0" text="1" />
        <Button fx:id="plusButton" mnemonicParsing="false" text="+" />
    </children>
</fx:root>
