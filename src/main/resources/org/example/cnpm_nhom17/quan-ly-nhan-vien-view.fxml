<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane fx:controller="org.example.cnpm_nhom17.QuanLyNhanVienController" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
            <children>
                <Button mnemonicParsing="false" onAction="#quayVeTrangBanHang" text="⬅ Quay lại Bán hàng" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Label text="QUẢN LÝ NHÂN SỰ" textFill="WHITE">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
            </children>
        </HBox>
    </top>

    <center>
        <HBox spacing="15.0" BorderPane.alignment="CENTER">
            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
            <children>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Tìm kiếm nhân viên:" />
                            <TextField fx:id="txtTimKiem" promptText="Nhập tên nhân viên..." prefWidth="300.0" />
                            <Button text="Làm mới" onAction="#taiDuLieuNhanVien" style="-fx-cursor: hand;" />
                        </HBox>
                        <TableView fx:id="bangNhanVien" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn prefWidth="100.0" text="Mã NV" />
                                <TableColumn prefWidth="300.0" text="Họ và Tên" />
                                <TableColumn prefWidth="200.0" text="Chức Vụ" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>

                <VBox spacing="15.0" prefWidth="350.0" style="-fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 15; -fx-background-color: #f8f9fa;">
                    <children>
                        <Label text="THÔNG TIN NHÂN VIÊN">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Separator />

                        <VBox spacing="5.0">
                            <Label text="Họ và tên:" />
                            <TextField fx:id="txtHoTen" promptText="VD: Trần Thị B" prefHeight="35.0" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label text="Chức vụ:" />
                            <ComboBox fx:id="cbChucVu" prefHeight="35.0" prefWidth="320.0" promptText="-- Chọn chức vụ --">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="ThuNgan" />
                                        <String fx:value="QuanLy" />
                                        <String fx:value="Kho" />
                                    </FXCollections>
                                </items>
                            </ComboBox>
                        </VBox>

                        <Separator />

                        <GridPane hgap="10.0" vgap="10.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <Button maxWidth="Infinity" maxHeight="Infinity" onAction="#xuLyThemNhanVien" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="THÊM MỚI" />
                                <Button maxWidth="Infinity" maxHeight="Infinity" onAction="#xuLyCapNhatNhanVien" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="CẬP NHẬT" GridPane.columnIndex="1" />
                                <Button maxWidth="Infinity" maxHeight="Infinity" onAction="#xuLyXoaNhanVien" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="XÓA NV" GridPane.rowIndex="1" />
                                <Button maxWidth="Infinity" maxHeight="Infinity" onAction="#xuLyXoaTrangForm" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="LÀM TRỐNG" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                            </children>
                        </GridPane>
                    </children>
                </VBox>

            </children>
        </HBox>
    </center>
</BorderPane>