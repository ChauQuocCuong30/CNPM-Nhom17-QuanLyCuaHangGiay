<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="760.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.cnpm_nhom17.Controller.MainController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
            <children>
                <Label text="NIKE POS" textFill="WHITE" prefWidth="150.0">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#moTrangKhachHang" text="Khách Hàng" style="-fx-background-color: #ecf0f1; -fx-cursor: hand;" />
                <Button onAction="#moTrangMaGiamGia" text="Mã Giảm Giá" style="-fx-background-color: #ecf0f1; -fx-cursor: hand;" />
                <Button onAction="#moTrangNhanVien" text="Nhân Viên" style="-fx-background-color: #ecf0f1; -fx-cursor: hand;" />
                <Button onAction="#moTrangHoaDon" text="Hóa Đơn" style="-fx-background-color: #ecf0f1; -fx-cursor: hand;" />
                <Button onAction="#moTrangQuanLyKho" text="Kho Hàng" style="-fx-background-color: #ecf0f1; -fx-cursor: hand;" />
                <Button onAction="#moTrangThanhToan" text="Thanh Toán" style="-fx-background-color: #f1c40f; -fx-font-weight: bold; -fx-cursor: hand;" />
            </children>
        </HBox>
    </top>

    <center>
        <HBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
            <children>
                <VBox spacing="15.0" prefWidth="350.0" style="-fx-border-color: #cccccc; -fx-padding: 15; -fx-background-color: #ffffff;">
                    <Label text="THÔNG TIN SẢN PHẨM"><font><Font name="System Bold" size="16.0" /></font></Label>

                    <TextField fx:id="txtSpTen" promptText="Tên giày (VD: Air Force 1)" />

                    <HBox spacing="10.0">
                        <ComboBox fx:id="cbSpDanhMuc" prefWidth="200.0" promptText="Chọn danh mục" HBox.hgrow="ALWAYS"/>
                        <Button text="+ Thêm" onAction="#xuLyThemDanhMucNhanh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button text="Xóa" onAction="#xuLyXoaDanhMucNhanh" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>

                    <HBox spacing="10.0">
                        <ComboBox fx:id="cbSpNhaCungCap" prefWidth="200.0" promptText="Chọn nhà cung cấp" HBox.hgrow="ALWAYS"/>
                        <Button text="+ Thêm" onAction="#xuLyThemNhaCungCapNhanh" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                        <Button text="Xóa" onAction="#xuLyXoaNhaCungCapNhanh" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>

                    <HBox spacing="10.0">
                        <TextField fx:id="txtSpSize" promptText="Size" prefWidth="100.0" />
                        <TextField fx:id="txtSpMau" promptText="Màu sắc" HBox.hgrow="ALWAYS" />
                    </HBox>

                    <TextField fx:id="txtSpBarcode" promptText="Quét / Nhập mã vạch (Barcode)" />

                    <TextField fx:id="txtSpGiaNhap" promptText="Giá nhập kho (VND)" />

                    <TextField fx:id="txtSpGiaBan" promptText="Giá bán niêm yết (VND)" />
                    <TextField fx:id="txtSpMin" promptText="Mức cảnh báo hết hàng (VD: 5)" />

                    <HBox spacing="10.0">
                        <Button text="THÊM MỚI" onAction="#xuLyThemSanPham" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="CẬP NHẬT" onAction="#xuLyCapNhatSanPham" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="XÓA" onAction="#xuLyXoaSanPham" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                    <Button text="Xóa trắng Form" onAction="#lamMoiFormSanPham" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;" maxWidth="Infinity"/>
                </VBox>

                <TableView fx:id="bangSanPham" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colQlyBarcode" prefWidth="120.0" text="Mã vạch" />
                        <TableColumn fx:id="colQlyTen" prefWidth="200.0" text="Tên Giày" />
                        <TableColumn fx:id="colQlyDanhMuc" prefWidth="80.0" text="Danh mục" />
                        <TableColumn fx:id="colQlyNhaCungCap" prefWidth="100.0" text="Nhà cung cấp" />
                        <TableColumn fx:id="colQlySize" prefWidth="60.0" text="Size" />
                        <TableColumn fx:id="colQlyMau" prefWidth="90.0" text="Màu sắc" />
                        <TableColumn fx:id="colQlyGia" prefWidth="120.0" text="Giá Bán" />
                        <TableColumn fx:id="colQlyTon" prefWidth="90.0" text="Tồn Kho" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </HBox>
    </center>
</BorderPane>