<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>


<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.BorderPane?>
<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="760.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.cnpm_nhom17.Controller.ThanhToanController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
            <children>
                <Button mnemonicParsing="false" onAction="#quayVeTrangChu" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-pref-height: 35.0;" text="🔙 Quay lại Cửa Hàng" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="THANH TOÁN" textFill="WHITE">
                    <font><Font name="System Bold" size="22.0" /></font>
                </Label>
            </children>
        </HBox>
    </top>
    <center>
        <HBox prefHeight="700.0" prefWidth="1200.0">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <TableView fx:id="productTableView" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="productNameCol" prefWidth="393.5" text="Tên sản phẩm" />
                                <TableColumn fx:id="quantityCol" prefWidth="103.0" text="Số lượng" />
                                <TableColumn fx:id="unitPriceCol" prefWidth="146.0" text="Đơn giá" />
                                <TableColumn fx:id="totalPriceCol" prefWidth="133.0" text="Thành tiền" />
                                <TableColumn fx:id="actionCol" prefWidth="83.0" text="Hành động" /> <!-- Cột mới cho nút Xóa -->
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <VBox.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" />
                            </VBox.margin>
                        </TableView>
                    </children>
                </VBox>
                <VBox prefWidth="300.0">
                    <children>
                        <VBox style="-fx-border-color: #cccccc; -fx-border-width: 1px;">
                            <VBox.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" />
                            </VBox.margin>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <Label text="Mã nhân viên:">
                                    <VBox.margin>
                                        <Insets bottom="5.0" />
                                    </VBox.margin>
                                </Label>
                                <ComboBox fx:id="employeeComboBox" maxWidth="1.7976931348623157E308" prefHeight="30.0" prefWidth="280.0">
                                    <VBox.margin>
                                        <Insets bottom="10.0" />
                                    </VBox.margin>
                                </ComboBox>
                            </children>
                        </VBox>
                        <VBox style="-fx-border-color: #cccccc; -fx-border-width: 1px;">
                            <VBox.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" />
                            </VBox.margin>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <Label text="Quét mã vạch:">
                                    <VBox.margin>
                                        <Insets bottom="5.0" />
                                    </VBox.margin>
                                </Label>
                                <TextField fx:id="barcodeTextField" prefHeight="30.0" promptText="Nhập hoặc quét mã vạch">
                                    <VBox.margin>
                                        <Insets bottom="5.0" />
                                    </VBox.margin>
                                </TextField>
                                <!-- Đã xóa QuantitySpinner ở đây vì đã có trong TableView -->
                            </children>
                        </VBox>
                        <VBox style="-fx-border-color: #cccccc; -fx-border-width: 1px;" VBox.vgrow="ALWAYS">
                            <VBox.margin>
                                <Insets left="5.0" right="5.0" top="5.0" />
                            </VBox.margin>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                            <children>
                                <Label text="Mã giảm giá:">
                                    <VBox.margin>
                                        <Insets bottom="5.0" />
                                    </VBox.margin>
                                </Label>
                                <!-- StackPane để chồng ComboBox và TextField -->
                                <StackPane>
                                    <children>
                                        <TextField fx:id="voucherDisplayTextField" editable="false" maxWidth="1.7976931348623157E308" prefHeight="30.0" promptText="Mã giảm giá được áp dụng tự động" />
                                        <ComboBox fx:id="allVouchersComboBox" editable="false" maxWidth="1.7976931348623157E308" prefHeight="30.0" promptText="Xem chi tiết các mã giảm giá" visible="false" />
                                    </children>
                                </StackPane>
                                <Label text="Số điện thoại khách hàng:">
                                    <VBox.margin>
                                        <Insets bottom="5.0" top="10.0" /> <!-- Điều chỉnh margin nếu cần -->
                                    </VBox.margin>
                                </Label>
                                <TextField fx:id="customerPhoneTextField" prefHeight="30.0" promptText="Số điện thoại khách hàng">
                                    <VBox.margin>
                                        <Insets bottom="5.0" />
                                    </VBox.margin>
                                </TextField>
                                <Label fx:id="customerPointsLabel" text="Điểm tích lũy: 0">
                                    <VBox.margin>
                                        <Insets bottom="10.0" />
                                    </VBox.margin>
                                </Label>
                                <Label text="Tổng tiền:">
                                    <VBox.margin>
                                        <Insets bottom="5.0" />
                                    </VBox.margin>
                                </Label>
                                <Label fx:id="totalAmountLabel" style="-fx-font-weight: bold;" text="0đ">
                                    <VBox.margin>
                                        <Insets bottom="5.0" />
                                    </VBox.margin>
                                </Label>
                                <Label fx:id="discountAmountLabel" text="0đ" wrapText="true">
                                    <VBox.margin>
                                        <Insets bottom="5.0" />
                                    </VBox.margin>
                                </Label>
                                <Label text="Tổng tiền cuối cùng:">
                                    <VBox.margin>
                                        <Insets bottom="5.0" />
                                    </VBox.margin>
                                </Label>
                                <Label fx:id="finalAmountLabel" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: red;" text="0đ">
                                    <VBox.margin>
                                        <Insets bottom="10.0" />
                                    </VBox.margin>
                                </Label>
                                <!-- Thêm ô nhập tiền khách đưa -->
                                <Label text="Tiền khách đưa:">
                                    <VBox.margin>
                                        <Insets bottom="5.0" />
                                    </VBox.margin>
                                </Label>
                                <TextField fx:id="customerMoneyTextField" prefHeight="30.0" promptText="Nhập số tiền khách đưa">
                                    <VBox.margin>
                                        <Insets bottom="10.0" />
                                    </VBox.margin>
                                </TextField>
                                <!-- Thêm ô hiển thị tiền thối -->
                                <Label text="Tiền thối lại:">
                                    <VBox.margin>
                                        <Insets bottom="5.0" />
                                    </VBox.margin>
                                </Label>
                                <Label fx:id="changeAmountLabel" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: blue;" text="0đ">
                                    <VBox.margin>
                                        <Insets bottom="10.0" />
                                    </VBox.margin>
                                </Label>
                                <Button fx:id="checkoutButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCheckout" prefHeight="40.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 16px;" text="THANH TOÁN">
                                    <VBox.margin>
                                        <Insets />
                                    </VBox.margin>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>

    </center>
</BorderPane>