<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane fx:controller="org.example.cnpm_nhom17.Controller.QuanLyHoaDonController" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
            <children>
                <Button mnemonicParsing="false" onAction="#quayVeTrangBanHang" text="⬅ Quay lại Bán hàng" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Label text="QUẢN LÝ HÓA ĐƠN &amp; THỐNG KÊ LỢI NHUẬN" textFill="WHITE">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
            </children>
        </HBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <tabs>
                <Tab text="1. Lịch sử Hóa Đơn">
                    <content>
                        <HBox spacing="15.0">
                            <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
                            <children>
                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" prefWidth="500.0">
                                    <Label text="DANH SÁCH HÓA ĐƠN ĐÃ THANH TOÁN" textFill="#2980b9"><font><Font name="System Bold" size="14.0" /></font></Label>
                                    <TableView fx:id="bangHoaDon" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn prefWidth="70.0" text="Mã HĐ" />
                                            <TableColumn prefWidth="150.0" text="Ngày Tạo" />
                                            <TableColumn prefWidth="120.0" text="Khách Hàng" />
                                            <TableColumn prefWidth="150.0" text="Tổng Tiền (VNĐ)" />
                                        </columns>
                                    </TableView>
                                </VBox>

                                <VBox spacing="10.0" HBox.hgrow="ALWAYS" prefWidth="500.0">
                                    <Label text="CHI TIẾT SẢN PHẨM TRONG HÓA ĐƠN" textFill="#27ae60"><font><Font name="System Bold" size="14.0" /></font></Label>
                                    <TableView fx:id="bangChiTietHD" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn prefWidth="200.0" text="Tên Giày" />
                                            <TableColumn prefWidth="60.0" text="Size" />
                                            <TableColumn prefWidth="80.0" text="Màu" />
                                            <TableColumn prefWidth="60.0" text="SL" />
                                            <TableColumn prefWidth="120.0" text="Giá Bán (VNĐ)" />
                                        </columns>
                                    </TableView>
                                </VBox>
                            </children>
                        </HBox>
                    </content>
                </Tab>

                <Tab text="2. Thống Kê &amp; Báo Cáo">
                    <content>
                        <BorderPane>
                            <top>
                                <HBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #f8f9fa;">
                                    <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                                    <children>
                                        <Label text="BÁO CÁO KẾT QUẢ HOẠT ĐỘNG KINH DOANH">
                                            <font><Font name="System Bold" size="24.0" /></font>
                                            <HBox.margin><Insets right="50.0" /></HBox.margin>
                                        </Label>
                                        <Label text="Từ ngày:">
                                            <font><Font name="System Bold" size="14.0" /></font>
                                        </Label>
                                        <DatePicker fx:id="dpTuNgay" prefWidth="150.0" />
                                        <Label text="Đến ngày:">
                                            <font><Font name="System Bold" size="14.0" /></font>
                                        </Label>
                                        <DatePicker fx:id="dpDenNgay" prefWidth="150.0" />
                                        <Button mnemonicParsing="false" onAction="#xuLyThongKe" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="LỌC DỮ LIỆU" />
                                        <Button mnemonicParsing="false" onAction="#xuatFileExcel" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="📗 XUẤT EXCEL" />
                                    </children>
                                </HBox>
                            </top>

                            <center>
                                <HBox spacing="20.0" BorderPane.alignment="CENTER">
                                    <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
                                    <children>

                                        <VBox spacing="15.0" prefWidth="300.0" HBox.hgrow="NEVER">
                                            <children>
                                                <VBox alignment="CENTER" prefHeight="150.0" style="-fx-background-color: #e8f8f5; -fx-border-color: #1abc9c; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 2;">
                                                    <children>
                                                        <Label text="TỔNG DOANH THU" textFill="#1abc9c"><font><Font name="System Bold" size="18.0" /></font></Label>
                                                        <Label fx:id="lblDoanhThu" text="0 đ" textFill="#1abc9c"><font><Font name="System Bold" size="28.0" /></font><VBox.margin><Insets bottom="5.0" top="10.0" /></VBox.margin></Label>
                                                        <Label text="(Tổng tiền khách đã thanh toán)" textFill="#7f8c8d" />
                                                    </children>
                                                </VBox>

                                                <VBox alignment="CENTER" prefHeight="150.0" style="-fx-background-color: #fef5e7; -fx-border-color: #f39c12; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 2;">
                                                    <children>
                                                        <Label text="TỔNG GIÁ VỐN" textFill="#f39c12"><font><Font name="System Bold" size="18.0" /></font></Label>
                                                        <Label fx:id="lblGiaVon" text="0 đ" textFill="#f39c12"><font><Font name="System Bold" size="28.0" /></font><VBox.margin><Insets bottom="5.0" top="10.0" /></VBox.margin></Label>
                                                        <Label text="(Giá nhập của các đôi giày đã bán)" textFill="#7f8c8d" />
                                                    </children>
                                                </VBox>

                                                <VBox alignment="CENTER" prefHeight="150.0" style="-fx-background-color: #f5eef8; -fx-border-color: #9b59b6; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-width: 2;">
                                                    <children>
                                                        <Label text="LỢI NHUẬN GỘP" textFill="#9b59b6"><font><Font name="System Bold" size="18.0" /></font></Label>
                                                        <Label fx:id="lblLoiNhuan" text="0 đ" textFill="#9b59b6"><font><Font name="System Bold" size="28.0" /></font><VBox.margin><Insets bottom="5.0" top="10.0" /></VBox.margin></Label>
                                                        <Label text="(Doanh Thu - Giá Vốn)" textFill="#7f8c8d" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>

                                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                                    <Label text="Xem chi tiết theo:" style="-fx-font-weight: bold;"/>
                                                    <ComboBox fx:id="cbTieuChiLoc" prefWidth="150.0" style="-fx-cursor: hand;" />
                                                </HBox>
                                                <TableView fx:id="bangBaoCao" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="colThoiGian" prefWidth="150.0" text="Thời Gian" />
                                                        <TableColumn fx:id="colDoanhThuCT" prefWidth="200.0" text="Doanh Thu" />
                                                        <TableColumn fx:id="colGiaVonCT" prefWidth="200.0" text="Giá Vốn" />
                                                        <TableColumn fx:id="colLoiNhuanCT" prefWidth="200.0" text="Lợi Nhuận" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                        </VBox>

                                    </children>
                                </HBox>
                            </center>
                        </BorderPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>